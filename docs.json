{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "almond",
  "name": "Pav API",
  "description": "The Pav API and MCP server: biopharma programs, drugs, companies, clinical trials, deals, patents and FDA records.",
  "colors": {
    "primary": "#15171C",
    "light": "#E8EAEE",
    "dark": "#15171C"
  },
  "appearance": {
    "default": "dark"
  },
  "fonts": {
    "family": "Inter"
  },
  "icons": {
    "library": "lucide"
  },
  "styling": {
    "eyebrows": "section",
    "codeblocks": "system"
  },
  "interaction": {
    "drilldown": false
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude"
    ],
    "display": "header"
  },
  "logo": {
    "light": "/logo/pav-api-light.svg",
    "dark": "/logo/pav-api-dark.svg"
  },
  "favicon": "/favicon.svg",
  "api": {
    "examples": {
      "languages": [
        "bash",
        "python",
        "javascript",
        "go"
      ]
    },
    "playground": {
      "display": "interactive"
    }
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Documentation",
        "groups": [
          {
            "group": "Overview",
            "pages": [
              "introduction",
              "quickstart",
              "data-overview"
            ]
          },
          {
            "group": "Datasets",
            "pages": [
              {
                "group": "Pipeline",
                "icon": "layers",
                "pages": [
                  "datasets/programs",
                  "datasets/drugs",
                  "datasets/companies"
                ]
              },
              {
                "group": "Clinical and regulatory",
                "icon": "shield-check",
                "pages": [
                  "datasets/clinical-trials",
                  "datasets/fda"
                ]
              },
              {
                "group": "Deals and patents",
                "icon": "briefcase",
                "pages": [
                  "datasets/deals",
                  "datasets/patents"
                ]
              }
            ]
          },
          {
            "group": "REST API",
            "pages": [
              "authentication",
              "rate-limits"
            ]
          },
          {
            "group": "AI agents",
            "pages": [
              "mcp-server",
              "openapi-and-agents"
            ]
          },
          {
            "group": "Guides",
            "pages": [
              "guides/competitive-landscape",
              "guides/deal-screening",
              "guides/patent-loe-check"
            ]
          },
          {
            "group": "Resources",
            "pages": [
              "concepts/coverage-and-sources"
            ]
          }
        ]
      },
      {
        "tab": "API Reference",
        "openapi": "openapi.json",
        "groups": [
          {
            "group": "Overview",
            "pages": [
              "api-reference/overview"
            ]
          }
        ]
      },
      {
        "tab": "Webhook Reference",
        "pages": [
          "webhooks/introduction"
        ]
      }
    ]
  },
  "redirects": [
    {
      "source": "/concepts/entities",
      "destination": "/datasets/programs"
    },
    {
      "source": "/concepts/data-quality-and-coverage",
      "destination": "/concepts/coverage-and-sources"
    },
    {
      "source": "/concepts/pagination",
      "destination": "/api-reference/overview"
    },
    {
      "source": "/concepts/search-and-filters",
      "destination": "/api-reference/overview"
    },
    {
      "source": "/datasets/fda-applications",
      "destination": "/datasets/fda"
    },
    {
      "source": "/conventions",
      "destination": "/api-reference/overview"
    },
    {
      "source": "/search",
      "destination": "/api-reference/overview"
    },
    {
      "source": "/datasets/changes",
      "destination": "/datasets/programs"
    },
    {
      "source": "/guides/track-pipeline-changes",
      "destination": "/guides/competitive-landscape"
    },
    {
      "source": "/api-reference/fda/list-orange-book-products",
      "destination": "/api-reference/orange-book-products/list-orange-book-products"
    },
    {
      "source": "/api-reference/fda/list-orange-book-patents",
      "destination": "/api-reference/orange-book-patents/list-orange-book-patents"
    },
    {
      "source": "/api-reference/fda/list-orange-book-exclusivities",
      "destination": "/api-reference/orange-book-exclusivities/list-orange-book-exclusivities"
    },
    {
      "source": "/api-reference/fda/list-purple-book-products",
      "destination": "/api-reference/purple-book-products/list-purple-book-products"
    },
    {
      "source": "/api-reference/fda/list-orphan-designations",
      "destination": "/api-reference/orphan-designations/list-orphan-designations"
    },
    {
      "source": "/api-reference/fda/list-warning-letters",
      "destination": "/api-reference/warning-letters/list-warning-letters"
    },
    {
      "source": "/api-reference/fda/list-recalls",
      "destination": "/api-reference/recalls/list-recalls"
    },
    {
      "source": "/api-reference/fda/list-drug-applications",
      "destination": "/api-reference/drug-applications/list-drug-applications"
    },
    {
      "source": "/api-reference/fda/get-a-drug-application",
      "destination": "/api-reference/drug-applications/get-a-drug-application"
    },
    {
      "source": "/api-reference/fda/list-complete-response-letters",
      "destination": "/api-reference/complete-response-letters/list-complete-response-letters"
    },
    {
      "source": "/api-reference/fda/list-accelerated-approvals",
      "destination": "/api-reference/accelerated-approvals/list-accelerated-approvals"
    },
    {
      "source": "/api-reference/fda/list-advisory-committee-meetings",
      "destination": "/api-reference/advisory-committee-meetings/list-advisory-committee-meetings"
    },
    {
      "source": "/api-reference/fda/get-an-fda-record",
      "destination": "/datasets/fda"
    }
  ],
  "navbar": {
    "primary": {
      "type": "button",
      "label": "Get API key",
      "href": "https://app.pav.bio/settings/developer"
    }
  },
  "footer": {
    "socials": {
      "website": "https://pav.bio"
    },
    "links": [
      {
        "header": "Documentation",
        "items": [
          {
            "label": "Quickstart",
            "href": "/quickstart"
          },
          {
            "label": "Data overview",
            "href": "/data-overview"
          },
          {
            "label": "MCP server",
            "href": "/mcp-server"
          }
        ]
      },
      {
        "header": "API Reference",
        "items": [
          {
            "label": "Overview",
            "href": "/api-reference/overview"
          },
          {
            "label": "Rate limits and errors",
            "href": "/rate-limits"
          },
          {
            "label": "OpenAPI spec",
