  "favicon": "/favicon.svg",
  "navigation": {
    "tabs": [
      {
        "tab": "Overview",
        "groups": [
          {
            "group": "Get started",
            "pages": [
              "introduction",
              "quickstart",
              "authentication",
              "mcp",
              "rate-limits"
            ]
          },
          {
            "group": "Core concepts",
            "pages": [
              "concepts/entities",
              "concepts/hybrid-search",
              "concepts/data-quality-and-coverage"
            ]
          }
        ]
      },
      {
        "tab": "API Reference",
        "openapi": "openapi.json"
      },
      {
