{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "almond",
  "name": "Pav API",
  "description": "The Pav API and MCP server: biopharma programs, drugs, companies, clinical trials, deals, patents and FDA records.",
  "colors": {
    "primary": "#002FA7",
    "light": "#8FA6E8",
    "dark": "#002FA7"
