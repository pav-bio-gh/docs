{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Pav API",
  "description": "The Pav API and MCP server: biopharma programs, companies, clinical trials, deals, patents, and change feeds.",
  "colors": {
    "primary": "#4C7CFF",
    "light": "#7B9CFF",
    "dark": "#2B4DBF"
  },
  "appearance": {
    "default": "light"
  },
  "logo": {
    "light": "/logo/pav-api-light.svg",
    "dark": "/logo/pav-api-dark.svg"
