{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Pav API",
  "description": "The Pav API and MCP server: biopharma programs, drugs, companies, clinical trials, deals, patents, FDA records, and change feeds.",
  "colors": {
    "primary": "#4C7CFF",
    "light": "#7B9CFF",
    "dark": "#2B4DBF"
  },
  "appearance": {
    "default": "light"
  },
  "logo": {
    "light": "/logo/pav-api-light.svg",
    "dark": "/logo/pav-api-dark.svg"
  },
  "favicon": "/favicon.svg",
  "navigation": {
    "tabs": [
      {
        "tab": "Documentation",
        "groups": [
          {
            "group": "Get started",
            "pages": [
              "introduction",
              "quickstart",
              "authentication",
              "rate-limits"
            ]
          },
          {
            "group": "Datasets",
            "pages": [
              "datasets/programs",
              "datasets/drugs",
              "datasets/companies",
              "datasets/clinical-trials",
              "datasets/deals",
              "datasets/patents",
              "datasets/fda",
              "datasets/fda-applications",
              "datasets/changes"
            ]
          },
          {
            "group": "Working with the API",
            "pages": [
              "concepts/search-and-filters",
              "concepts/pagination",
              "concepts/coverage-and-sources"
            ]
          },
          {
            "group": "Integrations",
            "pages": [
              "mcp-server",
              "openapi-and-agents"
            ]
          },
          {
            "group": "Guides",
            "pages": [
              "guides/competitive-landscape",
              "guides/deal-screening",
              "guides/patent-loe-check",
              "guides/track-pipeline-changes"
            ]
          }
        ]
      },
      {
        "tab": "API Reference",
        "openapi": "openapi.json"
      },
      {
        "tab": "Webhook Reference",
        "pages": [
          "webhooks/introduction"
        ]
      }
    ]
  },
  "redirects": [
    { "source": "/concepts/entities", "destination": "/datasets/programs" },
    { "source": "/concepts/data-quality-and-coverage", "destination": "/concepts/coverage-and-sources" }
  ],
  "navbar": {
    "links": [
      {
        "label": "Production API",
        "href": "https://api.pav.bio"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Get API key",
      "href": "https://app.pav.bio/settings/developer"
    }
  },
  "footer": {
    "socials": {
      "website": "https://pav.bio"
    }
  }
}
